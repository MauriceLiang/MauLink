{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Minimum capability for the MauLink desktop workspace",
  "windows": ["main"],
  "platforms": ["macOS", "windows"],
  "permissions": [
    "allow-app-get-info",
    "allow-group-list",
    "allow-group-create",
    "allow-group-update",
    "allow-group-delete",
    "allow-server-list",
    "allow-server-get",
    "allow-server-create",
    "allow-server-update",
    "allow-server-delete",
    "allow-server-appearance-list",
    "allow-server-appearance-get",
    "allow-server-appearance-update",
    "allow-server-runtime-stats-get",
    "allow-credential-list-retained",
    "allow-credential-delete-retained",
    "allow-credential-cleanup-retry",
    "allow-connection-start",
    "allow-connection-get",
    "allow-connection-cancel",
    "allow-connection-preflight",
    "allow-host-key-get",
    "allow-network-inspect",
    "allow-host-key-respond",
    "allow-auth-respond",
    "allow-connection-disconnect",
    "allow-terminal-open",
    "allow-terminal-get",
    "allow-terminal-write",
    "allow-terminal-resize",
    "allow-terminal-ack",
    "allow-terminal-close",
    "allow-sftp-list-start",
    "allow-sftp-list-next",
    "allow-sftp-list-close",
    "allow-sftp-stat",
    "allow-sftp-read-text",
    "allow-sftp-write-text",
    "allow-sftp-write-text-with-sudo",
    "allow-sftp-mkdir",
    "allow-sftp-rename",
    "allow-sftp-delete",
    "allow-sftp-upload",
    "allow-sftp-download",
    "allow-sftp-transfer-get",
    "allow-sftp-transfer-list",
    "allow-sftp-transfer-cancel",
    "allow-monitor-get-snapshot",
    "allow-monitor-get-history",
    "allow-monitor-refresh",
    "allow-workspace-set-activity",
    "allow-settings-get",
    "allow-settings-update",
    "allow-local-file-select",
    "allow-background-image-import",
    "allow-background-image-get",
    "allow-background-image-delete"
  ]
}
